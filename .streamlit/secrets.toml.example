# --- Todo dentro de [credenciales] (como en Streamlit Cloud) ---
[credenciales]
usuario = "su_usuario"
clave = "su_clave_secreta"
rol = "supervisor"
LLAVE_PRIVADA = "REEMPLAZAR_CON_HEX_DE_64_CARACTERES"
nombre_planta = "Planta Autorizada"

# Cuenta opcional de línea / operario (no congela ni descongela lotes)
[credenciales_operario]
usuario = "operario"
clave = "clave_operario"
rol = "operario"

# Alternativa: varios usuarios en lista
# [[usuarios]]
# usuario = "calidad"
# clave = "..."
# rol = "supervisor"
# [[usuarios]]
# usuario = "linea1"
# clave = "..."
# rol = "operario"

# Supabase — lectura exacta:
#   st.secrets["credenciales"]["SUPABASE_URL"]
#   st.secrets["credenciales"]["SUPABASE_KEY"]
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "eyJhbGciOi..."   # preferible service_role

# --- Avisos de ruptura de frío (opcional) ---
# Se disparan al registrar una lectura fuera de rango (cooldown 30 min/cámara).
[avisos]
email_to = "calidad@su-planta.com"
smtp_host = "smtp.gmail.com"
smtp_port = "587"
smtp_user = "cuenta@gmail.com"
smtp_pass = "app-password-de-gmail"
smtp_from = "validador@su-planta.com"

# WhatsApp (dejar para después si aún no lo usa)
# whatsapp_to = "51999999999"
# callmebot_apikey = "su_apikey_callmebot"

# Opcional Twilio WhatsApp (si usa Twilio, puede omitir callmebot_apikey)
# twilio_sid = "ACxxxx"
# twilio_token = "xxxx"
# twilio_from = "whatsapp:+14155238886"
