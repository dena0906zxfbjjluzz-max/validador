# --- Acceso planta (obligatorio en Cloud) ---
[credenciales]
usuario = "su_usuario"
clave = "su_clave_secreta"
# Opcional: LLAVE_PRIVADA también puede ir aquí
# LLAVE_PRIVADA = "hex_de_64_caracteres"

# --- Sello ECC (raíz o dentro de [credenciales]) ---
LLAVE_PRIVADA = "REEMPLAZAR_CON_HEX_DE_64_CARACTERES"

# Opcional — réplica del historial de reportes fuera del contenedor Cloud:
# SUPABASE_URL = "https://xxxx.supabase.co"
# SUPABASE_KEY = "eyJhbGciOi..."
# Tabla esperada (SQL):
# create table historial_reportes (
#   id bigint generated always as identity primary key,
#   fecha_hora text, lote text, hash_sha256 text unique, responsable text,
#   archivo text, producto text, registros int, firma_ecc text,
#   llave_publica text, mensaje text, modo_firma text, backend text
# );
