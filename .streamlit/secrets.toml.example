# --- Planta principal ---
[credenciales]
usuario = "su_usuario"
clave = "su_clave_secreta"
rol = "supervisor"
email = "supervisor@su-planta.com"
LLAVE_PRIVADA = "REEMPLAZAR_CON_HEX_DE_64_CARACTERES"
nombre_planta = "Planta Autorizada"
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "eyJhbGciOi..."

[credenciales_operario]
usuario = "operario"
clave = "clave_operario"
rol = "operario"
nombre_planta = "Planta Autorizada"

# Multi-planta (opcional): cada bloque = otra planta + usuario
# [plantas.ica]
# nombre = "Planta Ica"
# usuario = "admin_ica"
# clave = "..."
# rol = "supervisor"
# email = "calidad.ica@su-planta.com"

# --- Avisos de ruptura de frío (email + WhatsApp) ---
# Se disparan al registrar lectura fuera de rango (cooldown 30 min/cámara).
[avisos]
email_to = "calidad@su-planta.com"
smtp_host = "smtp.gmail.com"
smtp_port = "587"
smtp_user = "cuenta@gmail.com"
smtp_pass = "app-password-de-gmail"
smtp_from = "validador@su-planta.com"

# WhatsApp — CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-bot/
whatsapp_to = "51999999999"
callmebot_apikey = "su_apikey_callmebot"
# Alternativa Twilio:
# twilio_sid = "ACxxxx"
# twilio_token = "xxxx"
# twilio_from = "whatsapp:+14155238886"

# --- OTP por correo (doble factor) ---
# auto = activo si [avisos] tiene SMTP; true/false fuerza.
# Política: OTP solo para rol supervisor; operario entra con usuario/clave.
# Destino OTP: email del usuario (si tiene) > otp_email > avisos.email_to
[seguridad]
otp_habilitado = "auto"
# otp_email = "calidad@su-planta.com"

